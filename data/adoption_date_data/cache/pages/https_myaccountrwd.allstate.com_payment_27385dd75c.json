a.length; i++) {\n\t\t\tvar c = ca[i];\n\t\t\twhile (c.charAt(0) == ' ') {\n\t\t\t\tc = c.substring(1);\n\t\t\t}\n\t\t\tif (c.indexOf(name) == 0) {\n\t\t\t\treturn c.substring(name.length, c.length);\n\t\t\t}\n\t\t}\n\t\treturn \"\";\n\t}\n\tif (getCookie(\"IABenefitsVisited\") !== \"\" && getCookie(\"IABenefitsVisited\") == \"true\") {\n\t\tcreateCookie(\"ISAMERROR\", \"\");\n\t\tvar ABURL = getCookie(\"IABenefitsURL\");\n\t\tlocation.href = location.protocol + \"//\" + location.hostname + \"/AllstateBenefits/login.html?OrigURL=\" + ABURL;\n\t}\n\t\n\tif (getCookie(\"IABenefitsPDVisited\") !== \"\" && getCookie(\"IABenefitsPDVisited\") == \"true\") {\n\t\tcreateStandardCookie(\"ISAMERROR\", \"\");\n\t\tvar ABPDURL = getCookie(\"IABenefitsPDURL\");\n\t\tlocation.href = location.protocol + \"//\" + location.hostname + \"/MyAccess/login-prod.html?OrigURL=\" + ABPDURL;\n\t}\n\t\n\tif (getCookie(\"EPVisited\") !== \"\" && getCookie(\"EPVisited\") == \"true\") {\n\t\tcreateStandardCookie(\"ISAMERROR\", \"\");\n\t\tvar EPURL = getCookie(\"EPURL\");\n\t\tlocation.href = location.protocol + \"//\" + location.hostname + \"/BenefitsManager/index.html?OrigURL=\" + EPURL;\n\t}\n\t\n\tif (getCookie(\"DroveVisited\") !== \"\" && getCookie(\"DroveVisited\") == \"true\") {\n\t\tcreateCookie(\"ISAMERROR\", \"\");\n\t\tvar DroveURL = getCookie(\"DroveURL\");\n\t\tlocation.href = location.protocol + \"//\" + location.hostname + \"/Drove/login.html?OrigURL=\" + DroveURL;\n\t}\n\t\n\tif (getCookie(\"CtsAgencyVisited\") !== \"\" && getCookie(\"CtsAgencyVisited\") == \"true\") {\n\t\tcreateCookie(\"ISAMERROR\", \"\");\n\t\tvar CTSAgencyURL = getCookie(\"CTSAgencyURL\");\n\t\tlocation.href = location.protocol + \"//\" + location.hostname + \"/CTSAgency/login.html?OrigURL=\" + CTSAgencyURL;\n\t}\n\t\n\tvar hname=location.hostname.toUpperCase();\n\tif(hname == \"GOODHANDSROADSIDE.ALLSTATE.COM\" ) {\n\t\tlocation.href=location.protocol+\"//goodhandsroadside.allstate.com/ghrs/ghrweb/common/home\";\n\t}\n\tif(hname == \"M.GOODHANDSROADSIDE.ALLSTATE.COM\" ){\n\t\tlocation.href=\"https://m.goodhandsroadside.allstate.com/mghrs/mghrweb/common/home.htm\";\n\t}\n</script>\n\n<SCRIPT LANGUAGE=JavaScript>\nvar hname=location.hostname.toUpperCase();\nvar oldSession ='';\nvar origUrl = location.protocol + \"//\" + location.hostname + location.pathname + location.search;\nvar pname=location.pathname.toUpperCase();\nvar dict = {};\nvar parts = location.href.slice(location.href.indexOf('?') + 1).split(\"&\");\nfor (var part in parts) {\nvar key = parts[part].split(\"=\")[0];\nvar value = parts[part].split(\"=\")[1];\ndict[key] = key;\ndict[value] = value;\n}\n\nif(dict[value] == \"5O3Jdg6jKYRr72e4uTKr\"){\n\tcreateCookie(\"DroveURL\", escape(location));\n\tlocation.href  = location.protocol + \"//\" + location.hostname + \"/Drove/login.html?OrigURL=\" + escape(location);\n}\n\nif(dict[value] == \"R2BllBUBRlwh1bahS0ND\"){\n\tcreateCookie(\"CTSAgencyURL\", escape(location));\n\tlocation.href  = location.protocol + \"//\" + location.hostname + \"/CTSAgency/login.html?OrigURL=\" + escape(location);\n}\n\t\nif(dict[value] == \"4s2ongaxhpLTyiIE71bu\"){\n\tcreateCookie(\"IABenefitsURL\", escape(location));\n\tlocation.href  = location.protocol + \"//\" + location.hostname + \"/AllstateBenefits/login.html?OrigURL=\" + escape(location);\n}\n\nif(dict[value] == \"fCawv49R2JZHSKuFOEbe\" || dict[value] == \"8doFqBDHqkSHsnzl39BW\"){\n\tcreateStandardCookie(\"IABenefitsPDURL\", escape(location) + \"; Path=/;\");\n\tlocation.href = location.protocol + \"//\" + \"conacc.standard.com/MyAccess/login-prod.html?OrigURL=\" + escape(location);\n}\n\nif (dict[value] == \"BvUrry9nkdwC93QPx4KD\") {\n\tcreateStandardCookie(\"EPURL\", escape(location) + \"; Path=/;\");\n\tlocation.href = location.protocol + \"//\" + \"conacc.standard.com/BenefitsManager/index.html?OrigURL=\" + escape(location);\n}\nif(hname == \"MYACCOUNT.ALLSTATE.COM\" )\n{\nif(oldSession.length>0)\n{\n\tlocation.href=\"https://myaccount.allstate.com/anon/login/login.aspx?timeout=1\"+ \"&returnurl=\" + escape(origUrl);\n}\nelse\n{\n     location.href=\"https://myaccount.allstate.com/anon/login/login.aspx\"+ \"?returnurl=\" + escape(origUrl);\n}\n}\n\nif(hname == \"MYACCOUNT-TEMP.ALLSTATE.COM\" )\n{\nif(oldSession.length>0)\n{\n        location.href=\"https://myaccount-temp.allstate.com/anon/login/login.aspx?timeout=1\"+ \"&returnurl=\" + escape(origUrl);\n}\nelse\n{\n     location.href=\"https://myaccount-temp.allstate.com/anon/login/login.aspx\"+ \"?returnurl=\" + escape(origUrl);\n}\n}\nif(hname == \"EAXCIS.ALLSTATE.COM\" )\n{               \nlocation.href=\"https://eaxcis.allstate.com/Anon/Default.aspx?timeout=1\"+ \"&returnurl=\" + escape(origUrl);\n}\nif(hname == \"MILEWISE.ALLSTATE.COM\" )\n{\nlocation.href=\"https://milewise.allstate.com/milewise/common/apps/login?returnurl=\" + escape(origUrl);\n}\n\nif (hname == \"MYACCOUNTRWD.ALLSTATE.COM\" && origUrl.indexOf(\"secured/poe\") > -1)\n{\n   location.href=\"https://myaccountrwd.allstate.com/index-poe.html\";\n}\nelse if (hname == \"MYACCOUNTRWD.ALLSTATE.COM\" && origUrl.indexOf(\"secured/pre\") > -1)\n{\n   location.href=\"https://myaccountrwd.allstate.com/index-pre.html\";\n}\nelse if(hname == \"MYACCOUNTRWD.ALLSTATE.COM\")\n{\n    location.href=\"https://myaccountrwd.allstate.com/index.html\";\n}\nif(hname == \"MVP.ALLSTATE.COM\" )\n{\n     location.href=\"https://mvp.allstate.com/anon/splash\";\n}\n\nif(hname == \"DRIVEWISE.ALLSTATE.COM\" )\n{\nlocation.href=\"https://drivewise.allstate.com/dw/drivewise/common/login?returnurl=\" + escape(origUrl);\n}\nif(hname == \"ARSNETWORK.ALLSTATE.COM\" )\n{\n     location.href=\"https://arsnetwork.allstate.com/towingnetwork_PROD/ARSWebClaim/home/Home.action\";\n}\nif(hname == \"WWW.ARSNETWORK.ALLSTATE.COM\" )\n{\n     location.href=\"https://www.arsnetwork.allstate.com/towingnetwork_PROD/ARSWebClaim/home/Home.action\";\n}\nif((hname == \"MYACCOUNTS.ALLSTATE.COM\" ) && (pname.indexOf(\"ALLSTATECTSNGTHIRDPARTYSSWEB\") != -1))\n{\nif(oldSession.length>0)\n{\nlocation.href=\"https://myaccounts.allstate.com/AllstateCTSNGThirdPartySSWeb/Anon/Login.aspx?timeout=1\";\n}\nelse\n{\nlocation.href=\"https://myaccounts.allstate.com/AllstateCTSNGThirdPartySSWeb/Anon/Login.aspx\";\n}\n}\nif((hname == \"MYACCOUNTS.ALLSTATE.COM\" ) && (pname.indexOf(\"ALLSTATECTSNGCONSUMERSSWEB\") != -1))\n{\nlocation.href=\"https://myaccounts.allstate.com/AllstateCTSNGConsumerSSWeb/Common/Overlays/Stop.aspx\";\n}\nif (hname == \"PROVIDERPORTAL.ALLSTATE.COM\")\n{\nlocation.href = location.protocol+\"//providerportal.allstate.com/rr-prd/rspweb/common/login.do?returnurl=\" + escape(origUrl);\n}\n\nif(hname == \"EALIGN.ALLSTATE.COM\" )\n{       if(oldSession.length>0)\n        {location.href=\"https://ealign.allstate.com/SODCollectionWeb/Unauthorized/SODCollectionLoginPage.aspx?timeout=1\"+ \"&returnurl=\" + escape(origUrl);}\nelse\n        {location.href=\"https://ealign.allstate.com/SODCollectionWeb/Unauthorized/SODCollectionLoginPage.aspx\"+ \"?returnurl=\" + escape(origUrl);}\n}\n\nif(hname == \"ARS-ORS.ALLSTATE.COM\")\n{\nif(oldSession.length>0)\n{\nlocation.href=\"https://ars-ors.allstate.com/ors/index.html#/login?timeout=1\"+ \"&returnurl=\" + escape(origUrl);\n}\nelse\n{\n     location.href=\"https://ars-ors.allstate.com/ors/index.html#/login\"+ \"&returnurl=\" + escape(origUrl);\n}\n}\n\nif(hname == \"MY.ENCOMPASSINSURANCE.COM\" )\n{\n     location.href=\"https://my.encompassinsurance.com/Login\";\n}\n\n\n</SCRIPT>\n\n</head>\n\n<!--- BEGIN Cookie check block --->\n<!---\nDO NOT TRANSLATE anything inside the SCRIPT tag except the quoted \nstring warningString.  i.e. var warningString = \"Translate this string\";\n--->\n\n<body onload=\"setFocus()\">\n<div class=\"centered\">\n\t\n<SCRIPT LANGUAGE=JavaScript>\nvar warningString = \"<B>WARNING:</B> To maintain your login session, make sure that your browser is configured to accept Cookies.\";\ndocument.cookie = 'acceptsCookies=yes';\nif(document.cookie == ''){\ndocument.write(warningString);\n}\nelse{\ndocument.cookie = 'acceptsCookies=yes; expires=Fri, 13-Apr-1970 00:00:00 GMT';\n}\n</SCRIPT>\n<NOSCRIPT>\n<B>WARNING:</B> To maintain your login session, make sure that<BR>\nyour browser is configured to accept Cookies.\n</NOSCRIPT>\n<!--- END Cookie check block --->\n\t\t\n<FORM AUTOCOMPLETE=\"off\" METHOD=POST ACTION=\"/pkmslogin.form\">\n\t\t<table class=\"tableBlock\">\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td colspan=\"3\" class=\"logoBlock\" style=\"height: 66px\"><a href=\"http://www.allstate.com\"><img src=\"HTTPS://mma.allstate.com/imagefiles/allstate_logo.gif\" width=\"152\" height=\"43\" alt=\"Allstate Logo\"\n\t\t\t\t\t\t\t\t\tborder=\"0\"></a></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td colspan=\"3\">\n<SCRIPT LANGUAGE=JavaScript>\nvar errorString = '';\nif( errorString.length>0){\nvar hname=location.hostname.toUpperCase();\n\nif (hname == \"MMA.ALLSTATE.COM\" || hname == \"MMAADMIN.ALLSTATE.COM\" ) \n{\n\ndocument.write(\"The information that you have entered is incorrect.  If you are still having problems logging in, Please contact your local help desk.\");\n\n} \nelse if (hname == \"ARSNETWORK.ALLSTATE.COM\" || hname == \"WWW.ARSNETWORK.ALLSTATE.COM\" || hname == \"EAN.ALLSTATE.COM\")\n{\ndocument.write(\"The information that you have entered is incorrect.  If you are still having problems logging in, Please contact your local help desk at 800-582-6626.\");\n}\nif(hname == \"CLAIMINFO.ALLSTATE.COM\" )\n{\nif(oldSession.length>0)\n{\n\tlocation.href=\"https://claiminfo.allstate.com/AllstateCTSNGClaimInfoSSWeb/Anon/Login.aspx?action=SessionTimedOut\";\n}\nelse\n{\n     location.href=\"https://claiminfo.allstate.com/AllstateCTSNGClaimInfoSSWeb/Anon/Login.aspx\";\n}\n}\n}\n\n</SCRIPT>\n\n\n</td>\n\t\t\t\t\t</tr>\t\t\t\t\t\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td width=\"80\">&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"tableRow1\">User ID:\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"tableRow1\"><input id=\"username\" NAME=\"username\" size=\"24\">\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td>&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td width=\"68\" class=\"tableRow2\">Password:\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"tableRow2\"><input id=\"password\" type=\"password\" size=\"24\" name=\"password\">\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr><td><INPUT TYPE=\"HIDDEN\" NAME=\"login-form-type\" VALUE=\"pwd\"></td></tr>\n                                         <tr>\n\t\t\t\t\t\t<td>&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td>&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"tableRow2\"><input type=\"SUBMIT\" name=\"login\" border=\"0\" value=\"LOGIN\"></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td>&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td>&nbsp;\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"tableRow2\"><a href=\"javascript:toggle('list')\">Need Help Logging In?</a>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td colspan=\"3\" class=\"legalText\">\n\t\t\t\t\t\t\t<div id=\"list\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t<!--Your DIV content as follows. Note to add CSS padding or margins, do it inside a DIV within the Collapsible DIV -->\n\t\t\t\t\t\t\t\t<div style=\"PADDING-RIGHT: 5px; PADDING-LEFT: 5px; PADDING-BOTTOM: 0px; PADDING-TOP: 0px\">\n\t\t\t\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t\t\t\t<li id=\"arsli\"> For service provider website concerns, please contact 1-800-582-6626. Press #3\n\t\t\t\t\t\t\t\t\t\t<li>Check to make sure the Caps Lock on your keyboard is not on when entering your login information. User IDs and Passwords are case sensitive.\n\t\t\t\t\t\t\t\t\t\t<li>If you are having trouble remembering your User Id or Password please contact your local help desk.\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td colspan=\"3\" class=\"legalText\" style=\"text-align:justify\">\n\t\t\t\t\t\t\t<p>This is a private computer facility. Access to it for any reason must specifically be authorized. Unless you are specifically authorized, your continued access and further inquiry will expose you to prosecution to the fullest extent of federal, state and local laws.</p>\n\t\t\t\t\t\t\t<p>By logging on and continuing further on this site, the user agrees that he/she will not, at any time, or in any manner, directly or indirectly, disclose to any third party or permit any third party to access any confidential information concerning matters affecting or relating to the pursuits of Allstate, except upon direct written authority of Allstate. The user agrees that he/she will not use, or permit to be used, Allstate property or any information obtained or derived therefrom in any manner, directly or indirectly, other than in the performance of services for Allstate.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</form>\n\t\t</div>\n\t<script type=\"text/javascript\"  src=\"/ZdYOL2te/puL/KRd/WVroMvEuxB/9XuYpwiLY5z1hJw5Oi/EUxMcWA/fFcPal/kLXQYC\"></script><link rel=\"stylesheet\" type=\"text/css\"  href=\"/ZdYOL2te/puL/KRd/WVroMvEuxB/QzuYD1/NzQ7cWA/aw8NOX/VoQSxZ\"><script  src=\"/ZdYOL2te/puL/KRd/WVroMvEuxB/QzuYD1/NzQ7cWA/XgY7MW/wSH1kp\" async defer></script><div id=\"sec-overlay\" style=\"display:none;\"><div id=\"sec-container\"></div></div></body>\n</html>\n\n\n", "error": ""}